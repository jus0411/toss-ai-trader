# Trading Configuration
# 'mock' (가상 트레이딩 - 추천), 'real' (실제 매매 체결)
TRADING_MODE=mock

# Toss OpenAPI Credentials (토스 개발자 센터에서 발급: tsck_..., tssk_...)
TOSS_CLIENT_ID=your_toss_client_id_here
TOSS_CLIENT_SECRET=your_toss_client_secret_here

# Telegram Notification Bot (실시간 체결 알림)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Email Notification Configuration (Gmail SMTP - 일일 리포트용)
# 발송을 위해 Gmail 계정에서 '앱 비밀번호(App Password)'를 생성해 기입해야 합니다.
GMAIL_USERNAME=your_gmail_address@gmail.com
GMAIL_PASSWORD=your_gmail_app_password_here
REPORT_EMAIL_RECIPIENT=your_gmail_address@gmail.com

# Google Gemini API Key (실시간 차트 AI 투자 분석 진단용)
# 구글 AI 스튜디오(Google AI Studio)에서 발급받은 키를 기입하세요.
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (AI 투자위원회 ChatGPT 듀얼 분석용)
OPENAI_API_KEY=your_openai_api_key_here

# Groq API Key (무료 Llama 3.1 70B 모델 연동용)
GROQ_API_KEY=your_groq_api_key_here
